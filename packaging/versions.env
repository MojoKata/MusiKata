# Every input MusiKata's builds, tests and CI take from outside, pinned (docs/process/
# build-and-release.md, "Pinned inputs"). Sourced by the scripts; the environment can override
# PY_SERIES and PYSIDE, to try others.
#
# Every pin moves only to a release at least 14 days old (the cooldown), by a commit here;
# scripts/pins-newest.py shows each one's age and the newest it may move to.

# The Python every release carries, and development and the tests run on (R1.2): python-build-
# standalone's build <version>+<release>, and the SHA-256 of its install_only_stripped tarball for
# each platform. 3.15 waits for PyAV's wheels for it.
: "${PY_SERIES:=3.14}"
PYTHON_BUILD=3.14.10+20261026
PYTHON_LINUX_SHA256=4d3c16c59ed0802a3d1d34d8bce504b15ceeaff39d62dadecc6a9fa803412aed
PYTHON_WINDOWS_SHA256=c1876a9795d3a94ee49a1499a69cd91e26ca3e2829593f93fa6e4db90d05402b
PYTHON_MACOS_ARM64_SHA256=95eb8c87d16af37c54e9765e31d8c56c0d8ffa9968ea0f704f73a9b83f84e9f9
PYTHON_MACOS_X86_64_SHA256=2fd8becd48cf0ff5f0a15df3c0db7cae7aa708dcaacf901bd30d6cdd6229370b

# Qt 6.12 (LTS) is Qt's last version for Windows 10 (R1.1); moving past it is a decision, not an
# update (build-and-release.md). Essentials, Addons and shiboken6 move together.
: "${PYSIDE:=6.12.0}"

# What MusiKata runs on beside PySide6, each with its dependencies (R1.2.2, A6.1); the platform
# modules of A4.5 join with the code that uses them
RUNTIME="mutagen==1.48.1 numpy==2.5.4 av==19.0.2 truststore==0.10.5"

# pytest and pytest-qt with their dependencies, for every tier's Python (scripts/python-standalone.sh)
PYTEST="pytest==9.2.0 iniconfig==2.3.1 packaging==26.3 pluggy==1.7.0 Pygments==2.21.0 pytest-qt==4.5.0 typing-extensions==4.16.0"
# coverage.py, which measures tier 1 (docs/process/ci.md, "Coverage")
COVERAGE="coverage==7.17.2"
# the checks of docs/process/coding.md and testing.md: ruff, mypy, Hypothesis and jsonschema
RUFF="ruff==0.17.4"
MYPY="mypy==2.4.1 mypy-extensions==1.2.0 pathspec==1.1.1 librt==0.16.0 ast-serialize==0.13.1"
HYPOTHESIS="hypothesis==6.170.15 sortedcontainers==2.4.0"
JSONSCHEMA="jsonschema==4.26.0 attrs==26.1.0 jsonschema-specifications==2025.9.1 referencing==0.37.0 rpds-py==2026.9.1"
# mutmut and its dependencies, for mutation testing (testing.md, "Mutation testing"), apart from the
# tiers' Python (scripts/test-mutate.sh)
MUTMUT="mutmut==3.8.1 click==8.5.1 libcst==1.9.0 PyYAML==6.0.3 setproctitle==1.3.8 rich==15.0.0 markdown-it-py==4.2.0 mdurl==0.1.2"

# Docker goes by an image's digest; its tag only says what it is
NOBLE_IMAGE=ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852      # tier 1
